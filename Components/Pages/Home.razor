@page "/"
@using SoulScript.Data
@using SoulScript.Model
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<div class="home-container">
    <!-- Centered Hero Section -->
    <div class="hero-section text-center mb-12 mt-8">
        <!-- Date -->
        <MudText Typo="Typo.h5" Class="mb-4" Style="color: var(--mud-palette-text-secondary); font-weight: 500;">
            @DateTime.Now.ToString("dddd, MMMM d, yyyy")
        </MudText>

        <!-- Greeting -->
        <MudText Typo="Typo.h3" Style="font-weight: 700; color: var(--mud-palette-text-primary);" Class="mb-6">
            @_greeting, <strong>@_username</strong>
        </MudText>

        <MudText Typo="Typo.h6" Style="color: var(--mud-palette-text-secondary); font-weight: 400; max-width: 600px; margin: 0 auto;" Class="mb-8">
            Take a moment to reflect and capture your thoughts today.
        </MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Edit"
                   Class="py-3 px-8 elevation-4"
                   Style="border-radius: 24px; font-weight: 600; font-size: 1.1rem;"
                   OnClick="@(() => Nav.NavigateTo("/new-entry"))">
            Start Writing
        </MudButton>
    </div>

    <!-- Quick Access Cards -->
    <div class="quick-access-section mb-16">
        <MudGrid Spacing="4" Justify="Justify.Center">
            <MudItem xs="12" sm="4" md="3">
                <MudPaper Class="quick-card pa-6 text-center d-flex flex-column align-center elevation-4" 
                          Style="border-radius: 16px; cursor: pointer; transition: transform 0.2s;"
                          @onclick="@(() => Nav.NavigateTo("/dashboard"))">
                    <div class="card-icon-wrapper mb-4 pa-3 rounded-circle" style="background-color: var(--mud-palette-surface);">
                        <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Large" Color="Color.Primary" />
                    </div>
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Dashboard</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">View your stats</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="4" md="3">
                <MudPaper Class="quick-card pa-6 text-center d-flex flex-column align-center elevation-4" 
                          Style="border-radius: 16px; cursor: pointer; transition: transform 0.2s;"
                          @onclick="@(() => Nav.NavigateTo("/calendar"))">
                    <div class="card-icon-wrapper mb-4 pa-3 rounded-circle" style="background-color: var(--mud-palette-surface);">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Large" Color="Color.Secondary" />
                    </div>
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Calendar</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Browse by date</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="4" md="3">
                <MudPaper Class="quick-card pa-6 text-center d-flex flex-column align-center elevation-4" 
                          Style="border-radius: 16px; cursor: pointer; transition: transform 0.2s;"
                          @onclick="@(() => Nav.NavigateTo("/search"))">
                    <div class="card-icon-wrapper mb-4 pa-3 rounded-circle" style="background-color: var(--mud-palette-surface);">
                        <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Large" Color="Color.Tertiary" />
                    </div>
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Search</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Find entries</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </div>
</div>

<style>
    .quick-card:hover {
        transform: translateY(-4px);
    }
</style>

@code {
    private string _greeting = "Hello";
    private string _username = "Friend";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            SetGreeting();
            await LoadUser();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Home initialization error: {ex.Message}");
        }
    }

    private void SetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12) _greeting = "Good Morning";
        else if (hour < 18) _greeting = "Good Afternoon";
        else _greeting = "Good Evening";
    }

    private async Task LoadUser()
    {
        var user = await Db.Users.AsNoTracking().FirstOrDefaultAsync();
        if (user != null && !string.IsNullOrWhiteSpace(user.Username))
        {
            _username = user.Username;
        }
    }
}

