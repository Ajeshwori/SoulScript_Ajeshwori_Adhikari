@page "/search"
@using Microsoft.EntityFrameworkCore
@using SoulScript.Data
@using SoulScript.Model
@using SoulScript.Services

<div class="ss-search-page">
    <MudText Typo="Typo.h4" Class="ss-title">Search</MudText>
    <MudText Typo="Typo.body2" Class="ss-subtitle">Find entries by keyword, mood, tags, or date.</MudText>

    <!-- Search bar -->
    <div class="ss-block ss-searchbar">
        <MudTextField Value="@_searchText"
                      ValueChanged="@((string? v) => OnSearchTextChanged(v))"
                      Placeholder="Search entries by title, content, or tags..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      FullWidth="true"
                      Immediate="true" />
    </div>

    <!-- Filters grid -->
    <div class="ss-grid">
        <div class="ss-block ss-card ss-datecard">
            <MudText Typo="Typo.subtitle2">Date Range</MudText>
            <MudDateRangePicker DateRange="@_range"
                                DateRangeChanged="@OnRangeChanged"
                                Class="mt-2" />
        </div>

        <div class="ss-block ss-card ss-moodcard">
            <MudText Typo="Typo.subtitle2">Filter by Mood</MudText>

            <MudChipSet T="string"
                        MultiSelection="true"
                        CheckMark="true"
                        SelectedValues="@_selectedMoods"
                        SelectedValuesChanged="OnMoodsChanged"
                        Class="mt-2">
                @foreach (var mood in _allMoods)
                {
                    var isSelected = _selectedMoods.Contains(mood.MoodName);
                    <MudChip T="string"
                             Value="@mood.MoodName"
                             Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => ToggleMood(mood.MoodName))">
                        @mood.MoodName
                    </MudChip>
                }
            </MudChipSet>
        </div>
    </div>

    <!-- Tags -->
    <div class="ss-block ss-card ss-tagscard mt-4">
        <MudText Typo="Typo.subtitle2">Filter by Tags</MudText>

        <MudChipSet T="string"
                    MultiSelection="true"
                    CheckMark="true"
                    SelectedValues="@_selectedTags"
                    SelectedValuesChanged="OnTagsChanged"
                    Class="mt-2">
            @foreach (var t in _allTags)
            {
                var isSelected = _selectedTags.Contains(t);
                <MudChip T="string"
                         Value="@t"
                         Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => ToggleTag(t))">
                    @t
                </MudChip>
            }
        </MudChipSet>
    </div>

    <!-- Buttons -->
    <div class="ss-actions">
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Search"
                   OnClick="HandleApplyFilters">
            Apply Filters
        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   OnClick="HandleClearFilters">
            Clear
        </MudButton>
    </div>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-2" />
    }

    <MudDivider Class="my-2" />

    <!-- Results header -->
    <div class="d-flex justify-space-between align-center mt-4 mb-2">
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Showing @(_results?.Count ?? 0) of @(_totalEntries) entries
        </MudText>

        <MudLink OnClick="@(async _ => await ClearFilters())"
                 Underline="Underline.Always"
                 Color="Color.Default"
                 Typo="Typo.caption">
            Clear all filters
        </MudLink>
    </div>

    <!-- Results -->
    <div class="ss-results">
        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Class="my-2" />
        }
        else if (_results is null || _results.Count == 0)
        {
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-12">
                <MudPaper Class="d-flex align-center justify-center pa-4 rounded-lg mb-4"
                          Elevation="0"
                          Style="border: 1px solid var(--mud-palette-lines-default);">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff"
                             Style="font-size: 3rem; color: var(--mud-palette-text-disabled);" />
                </MudPaper>

                <MudText Typo="Typo.h6" Style="font-weight: 600;">No results found</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Try adjusting your search or filters to find what you're looking for.
                </MudText>
            </MudStack>
        }
        else
        {
            <div class="entries-list d-flex flex-column gap-4">
                @{
                    int cardIndex = 0;
                    string[] bgs = { "#FFF9E6", "#E8F5F3", "#FFF6E5" };
                }

                @foreach (var e in PagedResults)
                {
                    <MudPaper Elevation="0"
                              Class="pa-4 d-flex flex-column justify-space-between entry-card force-light-text"
                              Style="@($"background-color: {bgs[cardIndex % bgs.Length]}; border-radius: 16px; cursor: pointer;")"
                              OnClick="@(() => Nav.NavigateTo($"/entry/{e.EntryDate:yyyy-MM-dd}"))">

                        <div>
                            <div class="d-flex justify-space-between align-start mb-2">
                                <div class="d-flex gap-2">
                                    @foreach (var m in e.EntryMoods.Take(3))
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Surface">
                                            @m.Mood.MoodName
                                        </MudChip>
                                    }
                                    @if (e.EntryMoods.Count > 3)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                            +@(e.EntryMoods.Count - 3)
                                        </MudChip>
                                    }
                                </div>

                                @if (e.Category != null)
                                {
                                    <div class="px-2 py-1 rounded"
                                         style="background-color: rgba(255,255,255,0.6); font-size: 0.75rem; color: #555;">
                                        @e.Category.CategoryName
                                    </div>
                                }
                            </div>

                            <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight: 700;">
                                @(string.IsNullOrWhiteSpace(e.Title) ? "Untitled" : e.Title)
                            </MudText>

                            <MudText Typo="Typo.body2" Class="mb-3 search-entry-preview">
                                @Preview(e.Content)
                            </MudText>
                        </div>

                        <div>
                            <MudDivider Class="mb-3" Style="opacity: 0.1" />

                            <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
                                <div class="d-flex gap-4" style="font-size: 0.8rem; opacity: 0.8;">
                                    <div class="d-flex align-center gap-1">
                                        <MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Size="Size.Small" />
                                        @e.EntryDate.ToString("MMM dd, yyyy")
                                    </div>
                                    <div class="d-flex align-center gap-1">
                                        <MudIcon Icon="@Icons.Material.Outlined.AccessTime" Size="Size.Small" />
                                        @(e.WordCount) words
                                    </div>
                                </div>

                                <div class="d-flex gap-1">
                                    @foreach (var t in e.EntryTags.Take(3))
                                    {
                                        <div class="px-2 py-0 rounded-lg"
                                             style="background-color: white; font-size: 0.75rem; color: #666; border: 1px solid rgba(0,0,0,0.05);">
                                            @t.Tag.TagName
                                        </div>
                                    }
                                    @if (e.EntryTags.Count > 3)
                                    {
                                        <div class="px-2 py-0 rounded-lg"
                                             style="background-color: white; font-size: 0.75rem; color: #666; border: 1px solid rgba(0,0,0,0.05);">
                                            +@(e.EntryTags.Count - 3)
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="d-flex gap-2 justify-end" @onclick:stopPropagation="true">
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="@(() => Nav.NavigateTo($"/entry/{e.EntryDate:yyyy-MM-dd}"))">
                                    View
                                </MudButton>
                                <MudButton Variant="Variant.Filled"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="@(() => Nav.NavigateTo($"/entry/{e.EntryDate:yyyy-MM-dd}"))">
                                    Edit
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.Delete"
                                           OnClick="@(() => DeleteEntryFromList(e))">
                                    Delete
                                </MudButton>
                            </div>
                        </div>
                    </MudPaper>

                    cardIndex++;
                }
            </div>

            <!-- Pagination -->
            <div class="d-flex justify-center mt-8">
                <MudPagination SelectedChanged="PageChanged" Count="@_totalPages" Class="pa-4" />
            </div>
        }
    </div>
</div>
