@page "/all-entries"
@using Microsoft.EntityFrameworkCore
@using SoulScript.Data
@using SoulScript.Model

<div class="all-entries-container mb-16">
    <!-- Header -->
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 700;">All Entries</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@_totalEntries entries total</MudText>
        </div>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Success" 
                   StartIcon="@(_showFilters ? Icons.Material.Filled.FilterListOff : Icons.Material.Filled.FilterList)"
                   OnClick="@(() => _showFilters = !_showFilters)">
            Filters
        </MudButton>
    </div>

    <!-- Filters Panel -->
    <MudCollapse Expanded="_showFilters">
        <MudPaper Class="pa-4 mb-6 rounded-xl" Elevation="0" >
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Sort by" @bind-Value="_sortBy" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("Newest")">Newest first</MudSelectItem>
                        <MudSelectItem Value="@("Oldest")">Oldest first</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Filter by mood" Value="_filterMood" ValueChanged="OnFilterMoodChanged" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("All")">All moods</MudSelectItem>
                        @foreach (var m in _allMoods)
                        {
                            <MudSelectItem Value="@m.MoodName">@m.EmojiIcon @m.MoodName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            <div class="d-flex justify-end mt-2">
                 <MudButton Variant="Variant.Text" OnClick="ResetFilters">Reset</MudButton>
                 <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadData" Class="ml-2">Apply</MudButton>
            </div>
        </MudPaper>
    </MudCollapse>

    <!-- Entry List -->
    @if (_isLoading)
    {
         <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (_entries.Count == 0)
    {
        <MudPaper Class="pa-12 d-flex flex-column align-center justify-center rounded-xl dashed-border" Elevation="0" Style=" border: 2px;">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Default" Class="mb-4" Style="font-size: 3rem;" />
            <MudText Typo="Typo.h6" Color="Color.Secondary">No entries found</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Try adjusting your filters.</MudText>
        </MudPaper>
    }
    else
    {
        <div class="entries-list d-flex flex-column gap-4">
             @{
                int cardIndex = 0;
                // Pastel colors matching screenshot: Yellowish, Mint, Beige
                string[] bgs = { "#FFF9E6", "#E8F5F3", "#FFF6E5" }; 
            }
            @foreach (var e in _entries)
            {
                <MudPaper Elevation="0" Class="pa-4 d-flex flex-column justify-space-between entry-card force-light-text"
                  Style="@($"background-color: {bgs[cardIndex % bgs.Length]}; border-radius: 16px; cursor: pointer;")"
                  OnClick="@(() => Nav.NavigateTo($"/entry/{e.EntryDate:yyyy-MM-dd}"))">
                    
                    <div>
                        <div class="d-flex justify-space-between align-start mb-2">
                            <div class="d-flex gap-2">
                                 @foreach(var m in e.EntryMoods)
                                 {
                                     <MudText Typo="Typo.h5">@(m.Mood.EmojiIcon ?? "🙂")</MudText>
                                 }
                            </div>
                            @if(e.Category != null)
                            {
                                <div class="px-2 py-1 rounded" style="background-color: rgba(255,255,255,0.6); font-size: 0.75rem; color: #555;">
                                    @e.Category.CategoryName
                                </div>
                            }
                        </div>

                        <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight: 700;">
                            @(string.IsNullOrWhiteSpace(e.Title) ? "Untitled" : e.Title)
                        </MudText>

                        <MudText Typo="Typo.body2" Class="mb-3 entry-preview">
                        @((MarkupString)(e.Content ?? ""))
                    </MudText>
                    </div>

                    <div>
                        <MudDivider Class="mb-3" Style="opacity: 0.1"/>

                        <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
                             <div class="d-flex gap-4" style="font-size: 0.8rem; opacity: 0.8;">
                                <div class="d-flex align-center gap-1">
                                    <MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Size="Size.Small" />
                                    @e.EntryDate.ToString("MMM dd, yyyy")
                                </div>
                                <div class="d-flex align-center gap-1">
                                    <MudIcon Icon="@Icons.Material.Outlined.AccessTime" Size="Size.Small"/>
                                    @(e.WordCount) words
                                </div>
                             </div>
                             
                             <div class="d-flex gap-1">
                                 @foreach(var t in e.EntryTags.Take(3))
                                 {
                                      <div class="px-2 py-0 rounded-lg" style="background-color: white; font-size: 0.75rem; color: #666; border: 1px solid rgba(0,0,0,0.05);">
                                        @t.Tag.TagName
                                    </div>
                                 }
                                 @if(e.EntryTags.Count > 3)
                                 {
                                     <div class="px-2 py-0 rounded-lg" style="background-color: white; font-size: 0.75rem; color: #666; border: 1px solid rgba(0,0,0,0.05);">
                                        +@(e.EntryTags.Count - 3)
                                    </div>
                                 }
                             </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2 justify-end" @onclick:stopPropagation="true">
                            <MudButton Variant="Variant.Outlined" 
                                       Size="Size.Small" 
                                       Color="Color.Primary"
                                       OnClick="@(() => Nav.NavigateTo($"/entry/{e.EntryDate:yyyy-MM-dd}"))">
                                View
                            </MudButton>
                            <MudButton Variant="Variant.Filled" 
                                       Size="Size.Small" 
                                       Color="Color.Primary"
                                       OnClick="@(() => Nav.NavigateTo($"/entry/{e.EntryDate:yyyy-MM-dd}"))">
                                Edit
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       OnClick="@(() => DeleteEntryFromList(e))">
                                Delete
                            </MudButton>
                        </div>
                    </div>

                </MudPaper>
                cardIndex++;
            }
        </div>

        <!-- Pagination -->
        <div class="d-flex justify-center mt-8">
            <MudPagination SelectedChanged="PageChanged" Count="@_totalPages" Class="pa-4" />
        </div>
    }
</div>




