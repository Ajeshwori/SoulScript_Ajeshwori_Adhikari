@using MudBlazor

<MudNavMenu>

    <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home">
        Home
    </MudNavLink>

    <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">
        Dashboard
    </MudNavLink>

    <MudNavLink Href="/new-entry" Icon="@Icons.Material.Filled.EditNote">
        New Entry
    </MudNavLink>

    <MudNavLink Href="/all-entries" Icon="@Icons.Material.Filled.List">
        All Entries
    </MudNavLink>

    <MudNavLink Href="/calendar" Icon="@Icons.Material.Filled.CalendarMonth">
        Calendar
    </MudNavLink>

    <!-- 🔥 Dark / Light Mode Button -->
    <MudNavGroup Title="Mode" Icon="@Icons.Material.Filled.DarkMode">
        <MudButton Variant="Variant.Text"
                   Color="Color.Secondary"
                   StartIcon="@(_isDarkMode
                                                              ? Icons.Material.Filled.LightMode
                                                              : Icons.Material.Filled.DarkMode)"
                   OnClick="ToggleDarkMode">
            @(_isDarkMode ? "Light Mode" : "Dark Mode")
        </MudButton>
    </MudNavGroup>

    <MudNavLink Href="/search" Icon="@Icons.Material.Filled.Search">
        Search
    </MudNavLink>

    <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">
        Settings
    </MudNavLink>

    <MudNavLink Href="/lock-journal" Icon="@Icons.Material.Filled.Lock">
        Lock Journal
    </MudNavLink>

</MudNavMenu>

@code {
    [Parameter] public bool _isDarkMode { get; set; }
    [Parameter] public EventCallback ToggleDarkMode { get; set; }
}
